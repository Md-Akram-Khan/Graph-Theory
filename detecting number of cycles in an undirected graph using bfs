void solve()
{
    int n, m;
    cin>>n>>m;
    vector<int>adj[n], deg(n, 0);
    for(int i = 0; i < m; i++)
    {
        int u, v;
        cin>>u>>v;
        u--, v--;
        adj[u].pb(v);
        adj[v].pb(u);
        deg[u]++;
        deg[v]++;
    }
    vector<int> vis(n, 0);
    int cnt = 0;
    for(int i = 0; i < n; i++)
    {
        if(!vis[i])
        {
            queue<pair<int, int>>q;
            q.push({i, -1});
            vis[i] = 1;
            bool ok = 0;
            while(!q.empty())
            {
                int node = q.front().first, parent = q.front().second;
                q.pop();
                if(deg[node] != 2) ok = 1;
                for(auto i : adj[node])
                {
                    if(!vis[i])
                    {
                        vis[i] = 1;
                        q.push({i, node});
                    }
                }
                
            }
            if(ok == 0)
                 cnt++;
        }
    }
    cout<<cnt<<nl;
}
