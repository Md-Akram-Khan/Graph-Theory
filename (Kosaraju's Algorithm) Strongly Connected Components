// must be directed graph
// node A -> node B then node B -> node A 
void dfs(int node, vector<int> &vis, vector<int> adj[], stack<int> &st)
{
    vis[node] = 1;
    for(auto i: adj[node])
    {
        if(!vis[i])
            dfs(i, vis, adj, st);
    }
    st.push(node);
}
void dfs3(int node, vector<int> &vis, vector<int> adjT[])
{
    vis[node] = 1;
    for(auto i: adjT[node])
    {
        if(!vis[i])
            dfs3(i, vis, adjT);
    }
}
int kosaraju(int n, vector<int> adj[])
{
    vector<int> vis(n, 0);
    stack<int> st;
    for(int i = 0; i < n; i++)
    {
        if(!vis[i])
            dfs(i, vis, adj, st);
    }
    vector<int> adjT[n];
    for(int i = 0; i < n; i++)
    {
        vis[i] = 0;
        for(auto it: adj[i])
            adjT[it].push_back(i);
    }
    int scc = 0;
    while(!st.empty())
    {
        int node = st.top();
        st.pop();
        if(!vis[node])
        {
            scc++;
            dfs3(node, vis, adjT);
        }
    }
    return scc;
}
