    int ssize(int u)
    {
        return sz[findparent(u)];
    }
    
};
int spanningTree(int V, vector<vector<int>> adj[]) // V = node;
{
    vector<pair<int, pair<int, int>>> edge;
    for(int i = 0; i < V; i++)
    {
        for(auto j: adj[i])
        {
            edge.push_back({j[1], {i, j[0]}});
        }
    }
    sort(edge.begin(), edge.end());
    dsu graph(V);
    int sum = 0;
    for(int i = 0; i < edge.size(); i++)
    {
        if(graph.same_parent(edge[i].second.first, edge[i].second.second)) continue;
        sum += edge[i].first;
        graph.unionbysize(edge[i].second.first, edge[i].second.second);
    }
    return sum;
}
