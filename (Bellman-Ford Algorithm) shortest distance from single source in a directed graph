//can work with negative weight
//sortest cost from one source to other node
//can detect negative cycle
//if the graph is directed the vector edges will only contains edge of u -> v but if the graph is undirected the vector edges will contain both edges u -> v and v -> u
vector<int> bellman_ford(int V, vector<vector<int>>& edges, int S) { 
    vector<int> dis(V, 1e9); // safer to use 1e9
    dis[S] = 0;

    // Relax all edges V-1 times
    for (int i = 0; i < V - 1; i++) {
        for (auto it : edges) {
            int u = it[0], v = it[1], weight = it[2];
            if (dis[u] != 1e9 && dis[u] + weight < dis[v]) {
                dis[v] = dis[u] + weight;
            }
        }
    }

    // Check for negative weight cycles
    for (auto it : edges) {
        int u = it[0], v = it[1], weight = it[2];
        if (dis[u] != 1e9 && dis[u] + weight < dis[v]) {
            cout << "YES, Negative cycle detected.\n";
            break;
        }
    }

    return dis;    
}
